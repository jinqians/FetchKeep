# ---------------------------------------------------------------------------
# Proxies (optional)
# ---------------------------------------------------------------------------
# Leave empty or omit for direct VPS egress.
INSTAGRAM_PROXY=
TWITTER_PROXY=
TIKTOK_PROXY=
YOUTUBE_PROXY=
DOUYIN_PROXY=
BILIBILI_PROXY=

# ---------------------------------------------------------------------------
# 管理后台
# ---------------------------------------------------------------------------
# 不设置 ADMIN_TOKEN 时，/admin 和全部 /api/admin/* 一律返回 404，后台等于不存在。
# 这是故意的：Lite 是无密码公开部署，默认敞开的后台就是对外开放的 Cookies 上传
# 表单。要用后台就设一个，至少 16 位随机字符：
#
#   openssl rand -base64 24
#
# 设好之后打开 http://<你的地址>/admin 输入口令。口令只存在浏览器当前标签页，
# 关掉标签页就没了。后台能做的事：看运行概览、管理下载任务、上传/删除各平台
# Cookies、查看代理出口（凭据打码）、手动触发清理。
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# 源码链接（AGPL-3.0 §13）
# ---------------------------------------------------------------------------
# 本项目以 AGPL-3.0 授权。只要你把它架在网上给人用，使用者就有权拿到「这个部署」
# 的源码 —— 包括你的修改，不只是上游的代码。设置后页脚会显示源码链接，这是许可证
# 自己建议的提供方式。改过代码的话请指向你的 fork，而不是上游。
#   SOURCE_URL=https://github.com/jinqians/FetchKeep
SOURCE_URL=

# 用 Docker Hub 上发布的镜像而不是本地构建时填这个。生产环境建议钉死具体版本，
# 别用 latest：
# FETCHKEEP_IMAGE=jinqians/fetchkeep:latest

# ---------------------------------------------------------------------------
# Capacity / retention
# ---------------------------------------------------------------------------
WEB_PORT=9080
MAX_WORKERS=2
JOB_RETENTION_HOURS=24

# How long yt-dlp may wait on a silent socket before giving up.
YTDLP_SOCKET_TIMEOUT=30

# ---------------------------------------------------------------------------
# Cookies —— 服务端配置，前端没有上传入口
# ---------------------------------------------------------------------------
# Cookie jar 就是导出它的那个账号的活会话。公开的下载页面如果能上传，等于公开
# 收集别人的会话，所以 Lite 只从服务端读，两种方式都行：
#
#   1. 直接放文件（推荐）：把浏览器导出的 Netscape 格式 cookies.txt 放进
#      COOKIES_DIR，按平台命名 —— instagram.txt / youtube.txt / tiktok.txt /
#      douyin.txt / bilibili.txt。默认 ./data/cookies 已经挂进容器。
#
#   2. 写进环境变量：<平台>_COOKIES。内容是整份 cookies.txt，推荐 base64
#      （.env 放不下带 Tab 的多行文本）：
#          base64 -w0 bilibili.txt        # Linux
#          base64 -i bilibili.txt         # macOS
#      也接受把 Tab/换行写成 \t 和 \n 的转义形式。
#      启动时会写进对应文件，环境变量优先于卷里的旧文件。
#
# 哪些平台需要：
#   douyin    —— 即使是公开视频，网页详情接口也要一份新鲜的 cookie 才给数据。
#                不过配了解析器之后大多数情况用不上（见下面的解析器链）。
#   bilibili  —— 匿名能下，但封顶 480p。SESSDATA 是解锁 1080p 及以上的开关，
#                所以这里空着是画质上限，不是失败。
#   instagram —— 私密内容、快拍需要。
#   youtube   —— 提示“请登录以确认您不是机器人”时需要。
#   tiktok    —— 少数地区限制内容需要。
COOKIES_DIR=/data/cookies
# 老部署遗留的通用 cookies.txt，仍然作为 Instagram 的兜底。
COOKIE_FILE=/data/cookies/cookies.txt

INSTAGRAM_COOKIES=
YOUTUBE_COOKIES=
TIKTOK_COOKIES=
DOUYIN_COOKIES=
BILIBILI_COOKIES=

# 也可以让某个平台的 cookie 指向别处挂进来的文件（比如只读的 secret）：
# BILIBILI_COOKIE_FILE=/run/secrets/bilibili_cookies

# ---------------------------------------------------------------------------
# 抖音/TikTok 解析器链
# ---------------------------------------------------------------------------
# yt-dlp 的抖音 extractor 跟不上平台的 X-Bogus/A_Bogus 签名轮换，隔一阵就整个
# 失效。解析器链在 yt-dlp 之前尝试解析出视频直链，解析成功就直接下载，绕开页面
# 提取；解析失败或直链下不动，再退回完整的 yt-dlp 流程。
#
# 一个都不配置时行为与之前完全一致（纯 yt-dlp）。

# 自托管解析器地址（推荐 Evil0ctal/Douyin_TikTok_Download_API）
# 用 compose 自带的那个容器的话，两句都要写：
#   COMPOSE_PROFILES=douyin-parser
#   DOUYIN_PARSER_URL=http://douyin-parser:8000
# 只写地址不开 profile，容器根本不会启动，解析会连不上然后退回 yt-dlp。
# 指向别处已有的实例则不需要开 profile。
DOUYIN_PARSER_URL=

# TikHub.io API 密钥（付费，约 $0.001/次）
# 申请地址：https://tikhub.io
TIKHUB_API_KEY=

# 解析器优先级，逗号分隔。可选值：self_hosted, tikhub, ytdlp
# 不写 ytdlp 不会禁用它 —— 解析器全失败时照样回退完整 yt-dlp 下载，只是省掉一次
# 结果会被丢掉的 -J 探测。
PARSER_PRIORITY=self_hosted,tikhub

# 每个解析器的 HTTP 超时（秒）
PARSER_TIMEOUT=15
